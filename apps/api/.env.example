# Copy to apps/api/.env before starting the API. This URL matches docker-compose.yml.
DATABASE_URL="postgresql://carebridge:carebridge@localhost:5433/carebridge?schema=public"
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h
DEMO_MODE=true
DEMO_SCENARIO_STATE=ready
